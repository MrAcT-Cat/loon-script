[Script]

http-response ^https?:\/\/kk\.weshine\.im\/v1\.0\/text2voice\/(checkCount|consumeCount) script-path=https://raw.githubusercontent.com/MrAcT-Cat/loon-script/main/kk_voice.js, requires-body=true, timeout=10, tag=KK键盘次数修改

http-response ^https?:\/\/kk\.weshine\.im\/v1\.0\/text2voice\/createTtsAudio script-path=https://raw.githubusercontent.com/MrAcT-Cat/loon-script/main/kk_voice.js, requires-body=true, timeout=10, tag=KK键盘变声修改


