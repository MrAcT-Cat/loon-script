#!name=KK键盘-无限变声解锁
#!desc=修改剩余变声次数，解锁无限免费变声
#!author=Custom
#!loon-version=3.2.0

[rewrite]
# 修改次数接口1
^https?:\/\/kk\.weshine\.im\/v1\.0\/text2voice\/(checkCount|consumeCount) jsonjq-response-body .data.totalCount = 999 | .data.currCount = 999
# 修改次数接口2
^https?:\/\/kk\.weshine\.im\/v1\.0\/text2voice\/createTtsAudio jsonjq-response-body .data.freeCount = 999

[mitm]
hostname = kk.weshine.im