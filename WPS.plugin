#!name = WPS签到
#!desc = 获取WPS Token并执行自动签到任务，可视化开关面板，支持自定义签到时间和代理策略
#!date = 2026-09-13
#!author = MaYIHEI / Loon新版适配
#!homepage = https://github.com/MaYIHEI/paperclip
#!icon = https://raw.githubusercontent.com/MaYIHEI/pin/refs/heads/main/app/wps.png
#!loon_version = 3.5.1(983)

[Argument]
arg1 = switch,true,tag=WPS签到任务
arg2 = switch,true,tag=WPS Token
arg3 = input,"0 10 * * *",tag=WPS定时
arg4 = policy,PROXY,tag=代理策略

[Rule]
DOMAIN,personal-act.wps.cn,PROXY

[Script]
request if ${url} ~= /^https:\/\/personal-act\.wps\.cn\/activity-rubik\/activity\/page_info/i then script("https://raw.githubusercontent.com/MaYIHEI/paperclip/refs/heads/main/app/wps/wps.cookie.js") with enable=${arg2}, tag="WPS Cookie", timeout=300, requires_body=false, img_url="https://raw.githubusercontent.com/MaYIHEI/pin/refs/heads/main/app/wps.png"

cron ${arg3} then script("https://raw.githubusercontent.com/MaYIHEI/paperclip/refs/heads/main/app/wps/wps.js") with enable=${arg1}, tag="WPS签到", timeout=120, img_url="https://raw.githubusercontent.com/MaYIHEI/pin/refs/heads/main/app/wps.png"

[MITM]
hostname = personal-act.wps.cn